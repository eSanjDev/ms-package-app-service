{
    "name": "esanj/app-service",
    "description": "The AppService package facilitates external service connection based on client ID.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Esanj Team"
        }
    ],
    "autoload": {
        "psr-4": {
            "Esanj\\AppService\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Esanj\\AppService\\Providers\\AppServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "firebase/php-jwt": "^6.11",
        "esanj/managers": ">=0.4.0 <0.5.0",
        "esanj/auth-bridge": ">=0.2.0 <0.3.0"
    },
    "suggest": {
        "esanj/layout-master": "Required for the web UI — the published views extend the layout-master master layout. Not needed in API-only mode (APP_SERVICE_JUST_API=true)."
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
